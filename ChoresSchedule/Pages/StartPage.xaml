<Page x:Class="ChoresSchedule.Pages.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChoresSchedule.Pages"
      mc:Ignorable="d" Background="White"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StartPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Семейный график" 
                   Grid.Row="0"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Bottom" 
                   Margin="30"
                   Style="{StaticResource TextHeader}"
                   MouseDown="ChangingProgramInformation_MouseDown"/>        

        <StackPanel Grid.Row="1" Grid.Column="1"  Margin="10" HorizontalAlignment="Center">
            <Border Style="{StaticResource CustomBorder}" VerticalAlignment="Top" Height="10" Width="200"/>
            <StackPanel HorizontalAlignment="Center">
                <Button  x:Name="startBtn"
                         Content="Приступить" 
                         Click="startBtn_Click"
                         Style="{StaticResource ButtonCard}" 
                         FontSize="{StaticResource CapitalFontSize}"
                         Margin="0,0,0,5"/>

                <Button  x:Name="informationBtn"
                         Content="О программе" 
                         Click="informationBtn_Click"
                         Style="{StaticResource ButtonCard}" 
                         FontSize="{StaticResource CapitalFontSize}"
                         Margin="0,5,0,5"/>

                <Button  x:Name="exitBtn"
                         Content="Выход" 
                         Click="exitBtn_Click"
                         Style="{StaticResource ButtonCard}" 
                         FontSize="{StaticResource CapitalFontSize}" 
                         Margin="0,5,0,5"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
