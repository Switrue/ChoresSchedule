<Page x:Class="ChoresSchedule.Windows.Schedule"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChoresSchedule.Windows"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Schedule" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MonthTextBlock" 
                   FontSize="24" 
                   HorizontalAlignment="Center" 
                   Margin="10" 
                   Style="{StaticResource DayHeaderStyle}"/>

        <UniformGrid x:Name="CalendarGrid" Grid.Row="1" Rows="7" Columns="7" Background="White"/>

        <Border Grid.Row="2" Style="{StaticResource CustomBorder}" Height="10" Margin="15,0,15,0" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="2" 
                    HorizontalAlignment="Center"
                    Style="{StaticResource StackPanelCard}">

            <Button Content="Узнать" 
                    x:Name="infoBtn" 
                    Click="PersonInfo_Click" 
                    Style="{StaticResource ButtonCard}" 
                    Margin="3"
                    Width="84"/>

            <Button Content="Назад" 
                    Click="NavigateToQuestionnaire" 
                    Style="{StaticResource ButtonCard}" 
                    Margin="3"
                    Width="84"/>
        </StackPanel>
    </Grid>
</Page>
