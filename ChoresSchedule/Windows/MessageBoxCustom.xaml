<Window x:Class="ChoresSchedule.Windows.MessageBoxCustom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChoresSchedule.Windows"
        mc:Ignorable="d"
        Title="Информация"
        Icon="/Resources/logo.ico"
        SizeToContent="WidthAndHeight" 
        ResizeMode="NoResize"
        MinWidth="300" 
        MinHeight="150"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CustomBorder}" Width="10" HorizontalAlignment="Left"/>

        <TextBox x:Name="MessageText" 
                 Text="Ваш текст сообщения" 
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Center" 
                 Grid.Row="0"
                 Style="{StaticResource InformationText}"/>

        <Button Content="OK" 
                Width="84"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Margin="0,10,0,10"
                Click="OkButton_Click"
                Grid.Row="1"
                Style="{StaticResource ButtonCard}"/>
    </Grid>
</Window>
