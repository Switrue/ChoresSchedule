<Window x:Class="ChoresSchedule.Windows.PersonCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChoresSchedule.Windows"
        mc:Ignorable="d" ResizeMode="NoResize" Icon="/Resources/logo.ico"
        WindowStartupLocation="CenterScreen" Title="Информация" Height="300" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" 
           x:Name="userImage" 
           Style="{StaticResource ImageCard}"/>

        <Border Grid.Column="1" 
            Width="10"
            Style="{StaticResource CustomBorder}"
            Margin="0,10,0,10" 
            HorizontalAlignment="Left"/>

        <TextBox Grid.Column="1"
                 x:Name="informationTBl" 
                 VerticalAlignment="Center"
                 Text="Информация" 
                 Style="{StaticResource InformationText}"/>
    </Grid>
</Window>
